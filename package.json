{
  "name": "hanzi-lens",
  "version": "0.3.0-beta.1",
  "description": "Chinese-English lookup and screen capture for Windows",
  "private": true,
  "main": "src/main.cjs",
  "author": "Hanzi Lens contributors",
  "scripts": {
    "assets": "node scripts/download-assets.cjs",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win portable --x64",
    "setup:electron": "node scripts/install-electron.cjs",
    "test:ui": "node --test test/ui.smoke.cjs",
    "test:ocr": "node scripts/smoke-ocr.cjs",
    "test:electron": "node --test test/electron.smoke.cjs",
    "test:windows": "node --test test/windows-selection.native.cjs",
    "test:translation": "node scripts/translation-smoke.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "cedict-json": "1.3.20251213",
    "opencc-js": "1.4.2",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "dev.hanzilens.desktop",
    "productName": "Hanzi Lens",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "data",
        "filter": [
          "*.txt",
          "*.traineddata",
          "*.md"
        ]
      },
      {
        "from": "src/copy-selection.ps1",
        "to": "data/copy-selection.ps1"
      }
    ],
    "asarUnpack": [
      "node_modules/**/*",
      "src/local-translation-worker.cjs",
      "src/translation-text.cjs"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "dist"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
